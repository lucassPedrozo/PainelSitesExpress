# Pasta raiz do Drive onde ficam as pastas de coleta dos clientes
DRIVE_ROOT_FOLDER_ID=coloque_o_id_da_pasta_aqui

# Caminho da chave da service account (relativo à raiz do projeto ou absoluto)
GOOGLE_CREDENTIALS_PATH=sua-chave-service-account.json

PORT=3333
CACHE_TTL_MS=60000

# --- Lovable ---------------------------------------------------------------
# Trava de gasto. Enquanto não for 1, o painel monta e confere o envio mas
# nunca chama `create_project` — a única tool do Lovable que debita crédito.
LOVABLE_ENABLE_GENERATION=0

# Tetos por envio (o Lovable não publica os limites dele; estes são nossos)
LOVABLE_MAX_ATTACHMENTS=20
# 64 MB — vídeo e compactado costumam passar de 20 MB
LOVABLE_MAX_ATTACHMENT_BYTES=67108864

# Imagens de banco (Pixabay) na tela de geração. A chave aparece no topo de
# https://pixabay.com/api/docs/ com a conta logada. Vazia, a opção some.
PIXABAY_API_KEY=

# --- Assistente (Gemini) ----------------------------------------------------
# Chave do nível gratuito do Google AI Studio (https://aistudio.google.com/).
# Liga o botão "Analisar com Gemini" na tela de geração: resumo do briefing, o
# que falta, complementos para as observações e termos para o banco de imagens.
# O painel só usa modelos Flash, só quando alguém clica, e guarda cada resposta
# por 24 h — para a chave continuar gratuita. Vazia, o botão some.
GEMINI_API_KEY=
# Opcional: modelo preferido (ex.: gemini-3.8-flash). Vazio usa o apelido
# gemini-flash-lite-latest (responde em segundos) e, se faltar cota,
# gemini-flash-latest; se nenhum responder, o painel procura outro Flash de
# texto no catálogo da chave. Só modelos Flash são aceitos.
GEMINI_MODEL=

# --- Publicação (GitHub Actions + FTP) --------------------------------------
# Token fine-grained do GitHub (prefixo github_pat_). Permissões nos
# repositórios da organização:
#   Metadata: leitura
#   Contents, Workflows, Secrets, Actions: leitura e escrita
# Também pode ser preenchido pela tela "Deploy → Configurações" do painel.
GITHUB_TOKEN=

# Identificador da organização no GitHub. Sem ela o painel não lista nada.
GITHUB_ORG=

# Opcional: pré-preenche o campo "Servidor FTP" em repositórios novos.
DEFAULT_FTP_HOST=

# --- Rede -------------------------------------------------------------------
# Por padrão a API escuta só na própria máquina e nada trafega pela rede.
# Use 0.0.0.0 apenas se outras máquinas precisarem acessar — e, nesse caso,
# defina PANEL_ACCESS_TOKEN.
SERVER_HOST=127.0.0.1

# Obrigatória quando SERVER_HOST não é loopback. Mínimo de 16 caracteres.
PANEL_ACCESS_TOKEN=

# Opcional: hostnames internos com domínio, separados por vírgula.
# IPs privados, localhost, nomes simples e domínios .local já são aceitos.
LAN_ALLOWED_HOSTS=

# --- Encurtador de links (BetterLinks, via MCP) -----------------------------
# Mascara o link de visualização que vai ao cliente. O endereço curto é estável:
# quando o preview do Lovable é trocado, o painel reponta o mesmo link.
# O token sai de: WordPress > BetterLinks > Configurações > MCP.
BETTERLINKS_MCP_URL=https://seusite.com.br/betterlinks/mcp
BETTERLINKS_MCP_TOKEN=
# Opcional: só se os links curtos forem servidos por um domínio diferente do
# que responde o MCP. Vazio usa a origem da própria URL acima.
BETTERLINKS_PUBLIC_BASE=
# Intervalo da varredura automática dos links de cliente. 0 desliga e deixa
# apenas o botão manual.
PREVIEW_WATCH_INTERVAL_MS=1800000

# --- Área de desenvolvimento ------------------------------------------------
# Cada site é publicado numa pasta deste domínio (https://.../zezinho/) a cada
# push no repositório, e esse é o link que o cliente recebe para aprovar. O
# painel publica sozinho assim que o projeto é conectado ao GitHub no Lovable.
# Sem as quatro primeiras, a área fica desligada e vale o Share preview.
DEV_AREA_URL=https://aprovacao.exemplo.com.br
DEV_AREA_FTP_SERVER=
DEV_AREA_FTP_LOGIN=
DEV_AREA_FTP_PASSWORD=
# Pasta do domínio vista pelo FTP. Vazio usa domains/<domínio>/public_html
# (conta principal do DirectAdmin); uma conta FTP presa ao domínio usa "/".
DEV_AREA_FTP_DIR=
# Opcionais: ftps, ftps-legacy ou ftp (vazio testa FTPS), e a porta.
DEV_AREA_FTP_PROTOCOL=
DEV_AREA_FTP_PORT=
# Intervalo da varredura que acha repositórios novos. 0 desliga a publicação
# automática e deixa só o botão do painel.
DEV_AREA_WATCH_INTERVAL_MS=180000

# --- Motores de geração -------------------------------------------------------
# O motor que vem marcado na tela de geração: lovable ou claude. Cada geração
# pode trocar o motor na própria tela; isto é só a escolha inicial.
GENERATION_ENGINE=lovable

# --- Motor Claude --------------------------------------------------------------
# O Claude Code desta máquina (login da assinatura, sem chave de API) escreve o
# briefing e o site, e o site passa por rodadas de crítica e refino antes de ser
# entregue. O pacote do motor fica em joinvixable/, que vem de um repositório
# privado e não é versionado aqui.
#
# 1 libera o uso. Com 0 o painel monta e confere o pedido e mostra o comando,
# mas nunca dispara o Claude Code. Ligado, cada briefing, site, crítica, refino,
# ajuste e teste consome a assinatura.
CLAUDE_ENABLE_GENERATION=0
# Vazio usa o modelo que o motor espera (claude-opus-5-5; aparece em
# Configurações → Motor Claude). É o padrão: cada projeto pode escolher outro.
CLAUDE_MODEL=
# Esforço de raciocínio: low, medium, high, xhigh ou max. Vazio usa o que o
# motor espera. É o padrão: cada projeto pode escolher outro.
CLAUDE_REASONING_EFFORT=
# Rodadas de crítica e refino depois da geração, de 1 a 4; cada rodada são duas
# execuções a mais. Vazio usa o padrão do motor.
CLAUDE_REVIEW_ROUNDS=
# Quantos ajustes rodam ao mesmo tempo, ao lado da criação de um site: de 0 (tudo em uma fila só) a 4. Vazio: 2.
CLAUDE_PARALLEL_ADJUSTMENTS=
# Direção de arte (sobria, autoral ou ousada) e movimento (discreto, expressivo
# ou cinematografico) dos sites. Vazio usa o padrão do motor.
CLAUDE_ART_DIRECTION=
CLAUDE_MOTION=
# Escolha da rota criativa: vazio usa o padrão do motor, 1 para a geração depois
# da direção criativa e espera alguém escolher a rota no projeto, 0 segue sem
# parar.
CLAUDE_HUMAN_APPROVAL=
# Só se o painel não achar sozinho: o caminho completo do claude e o do Chrome,
# Edge ou Chromium que fotografa o site.
CLAUDE_BIN=
CLAUDE_BROWSER_PATH=

# --- Modelo de IA do "Lovable próprio" (em preparação, desligado) --------------
# Provedor e chave do modelo. A tela Configurações testa a chave listando os
# modelos, sem custo.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5
